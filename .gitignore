# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Virtual environment ---
# The venv is recreated from requirements.txt; never commit it.
.venv/
venv/

# --- Editor / OS ---
# Excel writes ~$name.xlsx beside a workbook while it is open, and deletes it on
# close. It is a lock file, not data, and it appeared in a commit the first time
# a case workbook was opened to look at.
~$*

# Claude Code's own working directory. It holds git worktrees for background
# tasks -- a live one is several megabytes of checked-out repository. It does
# not show in `git status` while a worktree is registered, because git hides
# those, so this is easy to miss until the task ends and the directory turns
# up as untracked.
.claude/

# .vscode is NOT ignored wholesale: settings.json is committed so that
# Positron picks up the right interpreter for everyone who clones this.
.vscode/*
!.vscode/settings.json
.DS_Store

# --- Data ---
# The input tables ARE the work, so every case folder is tracked. Only the
# generated outputs are ignored.
#
# This used to be inverted: ignore data_folder/* wholesale, then un-ignore each
# case by name. When basic_test, defect_cases and template moved into
# reference/, those un-ignore rules stopped matching anything -- and
# data_folder/bev_electronics, created later, was never named at all. The real
# case, with the only hand-written coefficient table in the project, went
# untracked for its whole life and nothing anywhere said so. Ignoring only the
# outputs cannot fail that way.
# The CONTENTS are ignored, not the directory itself: git cannot re-include a
# file whose parent directory is excluded, and two files below need including.
data_folder/**/output_data/**

# TCs_used.csv is the coefficient table each run actually solved -- after
# rest-derivation, precedence and wildcard expansion. It is tracked on purpose.
# The coefficients themselves now live in case.xlsx, and `git diff` on a
# spreadsheet says nothing, so without this a result could change with no way
# to see which coefficient moved. This file is text, so it diffs.
!data_folder/**/output_data/TCs_used.csv

# ...but not for the fixtures. The suites solve them on every run, so their
# TCs_used.csv would churn in every commit while saying nothing: a fixture's
# coefficients are pinned in the test, not something anyone edits.
data_folder/reference/**/output_data/TCs_used.csv

# The reference solution both engines are checked against.
!data_folder/reference/basic_test/output_data/solution.csv

# --- Figures ---
# Not tracked at all. Every figure is regenerated from the inputs and the
# settings by 02_run_model.py and 03_run_monte_carlo.py, so a committed copy is
# a stale copy the moment a setting changes. Same stance as output_data/ above:
# the inputs and the settings are the record.
figures/

# --- Profiling scratch ---
*test_size_*
