# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Virtual environment ---
# The venv is recreated from requirements.txt; never commit it.
.venv/
venv/

# --- Editor / OS ---
# .vscode is NOT ignored wholesale: settings.json is committed so that
# Positron picks up the right interpreter for everyone who clones this.
.vscode/*
!.vscode/settings.json
.DS_Store

# --- Data ---
# Real input data stays local. Two small case sets are tracked: basic_test,
# the reference case the model is checked against, and defect_cases, the
# minimal inputs that reproduce the engine divergences in documentation/.
data_folder/*
!data_folder/basic_test/
!data_folder/basic_test/**
!data_folder/defect_cases/
!data_folder/defect_cases/**

# The worked example of the proposed TC table schema (documentation/DESIGN_tc_table.md).
!data_folder/template/
!data_folder/template/**

# These outputs are regenerated on every run; only the inputs matter.
data_folder/defect_cases/*/output_data/
data_folder/template/output_data/

# Model outputs are regenerated on every run. The one exception is
# basic_test's solution.csv, which is the committed reference result.
data_folder/basic_test/output_data/*
!data_folder/basic_test/output_data/solution.csv

# --- Profiling scratch ---
*test_size_*
